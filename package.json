{
  "name": "lagophone",
  "version": "0.6.0",
  "private": true,
  "description": "Windows maintenance dashboard",
  "main": "electron/main.cjs",
  "author": "LAGOPHONE",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "test": "node electron/policy.test.cjs && node electron/optimization.test.cjs && node electron/windows-powershell.test.cjs && node electron/drivers.test.cjs && node electron/optimizer-session.test.cjs && node electron/activity.test.cjs && node electron/gpu-badge.test.cjs && node electron/restart.test.cjs && node electron/optimization-rating.test.cjs && node electron/windows-compatibility.test.cjs && node electron/optimization.windows.test.cjs && node electron/shader-preparation.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.lagophone.desktop",
    "productName": "LAGOPHONE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "shared/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/brand.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LAGOPHONE",
      "runAfterFinish": true,
      "artifactName": "LAGOPHONE-Setup-${version}-${arch}.${ext}",
      "installerIcon": "assets/brand.ico",
      "uninstallerIcon": "assets/brand.ico"
    },
    "portable": {
      "artifactName": "LAGOPHONE-Portable-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "electron/optimizer.ps1",
      "electron/registry-specs.json",
      "electron/game-executables.json"
    ]
  }
}
